# Local SQLite database
DATABASE_URL="file:./db/custom.db"

# ABHA / ABDM history integration
# demo = deterministic synthetic records for the prototype (default)
# live = call your registered ABDM HIU/gateway adapter server-side
ABDM_MODE="demo"
# Required only when ABDM_MODE=live. Keep these server-side; never expose them to NEXT_PUBLIC_*.
# ABDM_HISTORY_ENDPOINT="https://your-registered-hiu-gateway.example/api/abha/history"
# ABDM_ACCESS_TOKEN="replace-with-server-side-token"
